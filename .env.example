# ════════════════════════════════════════════════════════════
# Gridly — environment template
# ════════════════════════════════════════════════════════════
#   cp .env.example .env      then fill in the values below.
#
# One file covers both halves of the repo:
#   • the API reads it through api/config.ts, by absolute path,
#     so `npm run dev` works from any directory
#   • Vite reads the VITE_* keys at build time
#
# Real environment variables (Vercel, CI) override this file,
# so production sets these in the host's dashboard instead.
# ════════════════════════════════════════════════════════════


# ─── Server ─────────────────────────────────────────────────

# Port for the local API. Ignored on serverless hosting.
PORT=4000

# development | production. In production the refresh cookie is
# marked Secure, so it needs HTTPS.
NODE_ENV=development

# Comma-separated origins allowed to call the API. Must include
# the exact scheme, host, and port the browser uses.
#   e.g. https://gridly.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173


# ─── Database (required) ────────────────────────────────────

# MongoDB connection string, including the database name.
#   local:  mongodb://localhost:27017/gridly
#   Atlas:  mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/gridly
# On Atlas, allow your host's IPs under Network Access first.
MONGODB_URI=mongodb://localhost:27017/gridly


# ─── Auth (required) ────────────────────────────────────────

# Two DIFFERENT random strings — 64 hex chars each is plenty.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing either one signs every existing session out.
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-string

# Access token lifetime (kept short — the client silently
# refreshes) and refresh cookie lifetime.
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d


# ─── File storage (Cloudinary, optional) ────────────────────
# Powers card attachments and cover images. Find all three
# values on the Cloudinary dashboard under Account Details.
# Leave them empty to run without attachments: uploads then
# answer 503 UPLOADS_DISABLED and nothing else breaks.

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Top-level folder every upload lands in. Each board gets its
# own subfolder beneath it, e.g. gridly/<boardId>/file.png
CLOUDINARY_FOLDER=gridly

# Rejected above this size, per file.
MAX_FILE_SIZE_MB=10


# ─── AI (Google Gemini, optional) ───────────────────────────
# Powers "Draft with AI" and "Auto-generate steps". The key is
# only ever used server-side. Leave it empty to run without
# them: those routes answer 503 AI_DISABLED.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google retires model ids without notice — a dead one shows up
# as a 404 from the AI routes. List what your key can reach at
# https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY
# and put a current id here.
GEMINI_MODEL=gemini-3.5-flash


# ─── Client (baked into the bundle at build time) ───────────
# VITE_* values are PUBLIC — they ship to the browser. Never
# put a secret here.

# API base URL. In local dev, Vite proxies /api to the port
# above, so this only matters when the API lives elsewhere.
VITE_API_URL=http://localhost:4000/api

# WebSocket origin for live board updates. Leave empty in
# production if your host has no WebSocket support (Vercel);
# the board falls back to polling every 30s.
VITE_WS_URL=
